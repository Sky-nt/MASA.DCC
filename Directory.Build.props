<Project>
  <PropertyGroup>
    <MasaFrameworkPackageVersion>1.2.0-preview.*</MasaFrameworkPackageVersion>
    <!-- 固定为 Masa.Stack.Components 0.0.488 编译所依赖的版本，浮动到 preview.90 会导致 AddPmClient 签名不匹配（MissingMethodException） -->
    <MasaStackSdksPackageVersion>1.2.1-preview.1</MasaStackSdksPackageVersion>
    <MasaStackSdksBlazorServerPackageVersion>1.2.1-preview.1</MasaStackSdksBlazorServerPackageVersion>
    <TargetFramework>net8.0</TargetFramework>
    <DotnetVersion>8.*</DotnetVersion>
  </PropertyGroup>
</Project>