# ============================================================
# MASA DCC 服务器部署配置（模板）
# 本文件同时被 deploy.sh / run.sh / docker-compose.yml 读取
# 注意：真实凭据请只在服务器的部署包 .env 中填写，不要提交到仓库
# ============================================================

# ---------------- 镜像仓库（腾讯云 CCR）----------------
REGISTRY=ccr.ccs.tencentyun.com
REGISTRY_NAMESPACE=masa
REGISTRY_USER=<你的账号>
REGISTRY_PASSWORD=<你的密码>
# 镜像标签，deploy.sh 构建与推送、docker-compose.yml 拉取都以此为准
IMAGE_TAG=1.0.0

# ---------------- Git 源码 ----------------
GIT_URL=git@github.com:Sky-nt/MASA.DCC.git
GIT_BRANCH=main-niu-dev
# 相对本目录；脚本会把源码 clone/pull 到这里
SRC_DIR=./src/MASA.DCC

# ---------------- 外部 PostgreSQL ----------------
# DCC 源码只支持 PostgreSQL / SQL Server，不支持 MySQL
# 库名由 PG_DATABASE 指定（必须填写）
# 表放在 DB_SCHEMA 指定的架构（连接串追加 Search Path）；留空则用 public
PG_HOST=<外部PostgreSQL地址>
PG_PORT=5432
PG_USER=<账号>
PG_PASSWORD=<密码>
PG_DATABASE=<库名>
DB_SCHEMA=<架构>

# ---------------- 已存在的 Redis ----------------
# 注意：填「Docker 网络内部」可访问的主机名与端口，不是宿主机映射端口
# 自定义网络名用 docker network ls 查看，例如 baota_net
INFRA_NETWORK=baota_net

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------- MASA Stack 基础配置 ----------------
MASA_ENVIRONMENT=Production
MASA_VERSION=1.0.0
MASA_NAMESPACE=masastack
MASA_CLUSTER=Default
DOMAIN_NAME=masastack.local
# 没有 OTLP 采集端时保留一个语法合法的地址即可（导出失败只记日志）
OTLP_URL=http://127.0.0.1:4317
ADMIN_PWD=admin123
DCC_SECRET=masastack.com
IS_DEMO=False
# DCC 服务在容器网络内的地址（MASA_STACK 中 dcc.service.domain）
DCC_SERVICE_DOMAIN=http://masa-dcc-service

# ---------------- 独立鉴权（自研，不依赖 MASA Auth/SSO）----------------
STANDALONE_ENABLED=true
# 生产务必改成足够长的随机串
STANDALONE_JWT_SECRET=please-change-this-to-a-long-random-string-32+
STANDALONE_ADMIN_USER=admin
STANDALONE_ADMIN_PASSWORD=admin123
STANDALONE_TOKEN_EXPIRE_MINUTES=1440

# ---------------- 宿主机端口映射 ----------------
DCC_SERVICE_PORT=8890
DCC_WEB_PORT=8888
