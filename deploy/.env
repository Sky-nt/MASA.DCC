# ============================================================
# MASA DCC 独立部署配置（源码构建版）
# 说明：所有值都会被 docker-compose.yml 引用并注入到容器环境变量
# ============================================================

# ---------- 镜像 / 端口 ----------
DCC_SERVICE_IMAGE=masa-dcc-service:local
DCC_WEB_IMAGE=masa-dcc-web-admin:local
DCC_SERVICE_PORT=8890
DCC_WEB_PORT=8888

# ---------- 已有基础设施（MySQL / Redis 容器）----------
# 注意：填「Docker 网络内部」可访问的主机名与端口，不是宿主机映射端口！
#   docker inspect -f '{{.NetworkSettings.Networks}}' mysql
#   docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' mysql
INFRA_NETWORK=baota_net

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
# DCC 库名固定为 dcc（源码中 GetConnectionString("dcc") 推导得出，见 README）
DCC_DATABASE=dcc

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MASA Stack 基础配置 ----------
MASA_ENVIRONMENT=Production
MASA_VERSION=1.0.0
MASA_NAMESPACE=masastack
MASA_CLUSTER=Default
DOMAIN_NAME=masastack.local
# OTLP 采集端地址。没有采集端时保留一个语法合法的地址即可（导出失败只记日志，不影响启动）
OTLP_URL=http://127.0.0.1:4317
ADMIN_PWD=admin123
DCC_SECRET=masastack.com
IS_DEMO=False

# DCC 服务在容器网络内的地址（必须能被本服务自己访问到）
DCC_SERVICE_DOMAIN=http://masa-dcc-service

# ---------- 独立鉴权（自研，不依赖 MASA Auth/SSO）----------
STANDALONE_ENABLED=true
# 请务必改成一段足够长的随机字符串
STANDALONE_JWT_SECRET=please-change-this-to-a-long-random-string-32+
STANDALONE_ADMIN_USER=admin
STANDALONE_ADMIN_PASSWORD=admin123
STANDALONE_TOKEN_EXPIRE_MINUTES=1440
